{
  "name": "Trade",
  "type": "object",
  "properties": {
    "trade_id": {
      "type": "string",
      "description": "Unique trade identifier (TRD-XXXXXX)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "planning",
        "compliance_check",
        "finance_pending",
        "finance_accepted",
        "payment_pending",
        "payment_executing",
        "payment_completed",
        "payment_failed",
        "completed"
      ],
      "default": "draft"
    },
    "title": {
      "type": "string",
      "description": "Trade title/description"
    },
    "exporter_country": {
      "type": "string"
    },
    "importer_country": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "product_hs_code": {
      "type": "string"
    },
    "incoterm": {
      "type": "string",
      "enum": [
        "EXW",
        "FCA",
        "CPT",
        "CIP",
        "DAP",
        "DPU",
        "DDP",
        "FAS",
        "FOB",
        "CFR",
        "CIF"
      ]
    },
    "estimated_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "exporter_name": {
      "type": "string"
    },
    "importer_name": {
      "type": "string"
    },
    "shipping_date": {
      "type": "string",
      "format": "date"
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "current_step": {
      "type": "number",
      "default": 1
    },
    "compliance_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "warnings",
        "failed"
      ]
    },
    "finance_offer_id": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "proof_bundle_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "trade_id",
    "status"
  ]
}