{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "trade_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system"
      ]
    },
    "content": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "trade_plan",
        "action",
        "error"
      ]
    },
    "trade_plan_data": {
      "type": "object",
      "description": "Structured trade plan if message_type is trade_plan"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "role",
    "content"
  ]
}